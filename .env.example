NODE_ENV=development

# Local Compose services. Change only for non-default local infrastructure.
DATABASE_URL=postgresql://shoppilot:shoppilot_dev@localhost:5432/shoppilot
REDIS_URL=redis://localhost:6380
POSTGRES_PORT=5432
REDIS_PORT=6380

API_HOST=127.0.0.1
API_PORT=3001
WEB_HOST=127.0.0.1
WEB_PORT=3000
# Server-side destination for the web app's same-origin API proxy.
API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# ShopPilot supports Razorpay test mode only. Credentials are optional in fake mode.
RAZORPAY_MODE=test
PAYMENT_PROVIDER=fake
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Fake model is the safe local default. Never commit a real API key.
MODEL_PROVIDER=fake
OPENAI_MODEL=gpt-5.4-mini
OPENAI_API_KEY=
